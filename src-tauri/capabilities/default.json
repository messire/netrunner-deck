{
  "$schema": "https://schema.tauri.app/config/capabilities/2",
  "identifier": "default",
  "description": "Main window: core window controls, the Herdr bridge commands, notifications.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "notification:default"
  ]
}
