[Unit]
Description=deck-server (Netrunner Deck)
After=network-online.target

[Service]
# deck-server runs itself in the background and replaces itself on update
# (live handoff to a new process), so systemd only starts and stops it.
Type=oneshot
RemainAfterExit=yes
KillMode=process
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h
ExecStart=%h/.local/bin/deck-server start
ExecStop=%h/.local/bin/deck-server stop

[Install]
WantedBy=default.target
